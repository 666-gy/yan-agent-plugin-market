    {
      "id": "YanPlugin-we-need-reasoning",
      "name": "We Need Reasoning",
      "description": "把 DSH We Need 4.1.1 寄存器移植到 Yan：激活后在 127.0.0.1 启动独立常驻反向代理 daemon，对 chat/completions、responses、messages 请求注入 seed、system register、工具步锚与压缩规则，未匹配模型原样透传。MCP/内核退出不会关闭代理；含 we-need 技能、seed 组合与寄存器审计工具；内置本地配置页可直接设置并持久化上游地址；需自行添加指向代理 Base URL 的自定义连接，插件不改模型配置。",
      "category": "developer-tools",
      "repository": "fourorfor/YanPlugin-we-need-reasoning",
      "revision": "a79a7fe825162e710d5d26f5383255fa7c048d50",
      "digest": "ee97c2c546581305bb5654626cab0b650592496154fc5bf322d31c9d684c4dd9",
      "download": true,
      "manifest": {
        "schemaVersion": 1,
        "id": "YanPlugin-we-need-reasoning",
        "version": "1.0.2",
        "name": "We Need Reasoning",
        "description": "把 DSH We Need 4.1.1 寄存器移植到 Yan：激活后在 127.0.0.1 启动独立常驻反向代理 daemon，对 chat/completions、responses、messages 请求注入 seed、system register、工具步锚与压缩规则，未匹配模型原样透传。MCP/内核退出不会关闭代理；含 we-need 技能、seed 组合与寄存器审计工具；内置本地配置页可直接设置并持久化上游地址；需自行添加指向代理 Base URL 的自定义连接，插件不改模型配置。",
        "author": "Yan adaptation of DSH We Need Plugin contributors",
        "license": "MIT",
        "instructions": "instructions.md",
        "platforms": [
          "win32",
          "darwin",
          "linux"
        ],
        "skills": [
          {
            "id": "we-need",
            "name": "We Need Reasoning",
            "description": "用 Need / Should / Could / Must / Let's 组织计划、执行、压缩与委派外发；包含 seed 组合、工具步重锚、寄存器审计和本地代理验收。",
            "path": "skills/we-need/SKILL.md"
          }
        ],
        "resources": [
          {
            "id": "register",
            "name": "We Need 寄存器全文",
            "path": "skills/we-need/references/register.md"
          },
          {
            "id": "upstream-seed",
            "name": "上游 seed.txt 原文",
            "path": "seed.txt"
          },
          {
            "id": "readme",
            "name": "插件说明与安装步骤",
            "path": "README.md"
          }
        ],
        "mcpServers": [
          {
            "id": "weneed",
            "type": "local",
            "command": "$node",
            "args": [
              "${pluginRoot}/server.cjs"
            ],
            "timeoutMs": 120000,
            "env": {
              "WENEED_UPSTREAM_BASE_URL": "${config.upstreamBaseUrl}",
              "WENEED_LISTEN_PORT": "${config.listenPort}",
              "WENEED_TARGET_MODELS": "${config.targetModels}",
              "WENEED_MODE": "${config.mode}",
              "WENEED_SEED_MODE": "${config.seedMode}",
              "WENEED_SEED_LANGUAGE": "${config.seedLanguage}",
              "WENEED_AUTO_START": "${config.autoStart}"
            }
          }
        ],
        "configuration": {
          "upstreamBaseUrl": {
            "label": "上游 API 根地址",
            "description": "代理转发的真实端点，例如 https://api.deepseek.com 或 https://api.deepseek.com/v1。留空时代理返回 502，也可调用 proxy_start 临时传入。",
            "required": false,
            "default": ""
          },
          "listenPort": {
            "label": "本地监听端口",
            "description": "代理只绑定 127.0.0.1。默认 8787；端口固定，被占用时会明确报错，不再自动顺延。",
            "required": false,
            "default": "8787"
          },
          "targetModels": {
            "label": "目标模型匹配",
            "description": "分号分组、逗号表示同时包含，例如 deepseek,flash;weneed,ds41。不匹配的模型原样透传。",
            "required": false,
            "default": "deepseek,flash;weneed,ds41"
          },
          "mode": {
            "label": "寄存器模式",
            "description": "standard / goal / team。team 会把外发规则追加到委派类工具描述。",
            "required": false,
            "default": "standard"
          },
          "seedMode": {
            "label": "Seed 来源",
            "description": "upstream 使用包内 seed.txt 原文；task 按最新 user task 现场组合；off 只注入系统规则。",
            "required": false,
            "default": "upstream"
          },
          "seedLanguage": {
            "label": "Seed 语言",
            "description": "en（默认，与上游一致）、zh 或 auto。仅影响 task 模式。",
            "required": false,
            "default": "en"
          },
          "autoStart": {
            "label": "激活时自动启动代理",
            "description": "true 时 MCP 启动会确保独立 daemon 运行；false 时需调用 proxy_start。",
            "required": false,
            "default": "true"
          }
        }
      },
